# Required for live collection. Never commit real API keys.
SOLANA_HTTP_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_RPC_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

MEMEQUANT_DATA_DIR=./data
MEMEQUANT_PROVIDER_NAME=helius
MEMEQUANT_COMMITMENT=confirmed
MEMEQUANT_SUBSCRIPTION_MODE=auto
# Start cheap. Use pump,pumpswap only after measuring bandwidth/credits.
MEMEQUANT_PROTOCOLS=pump
MEMEQUANT_RECONCILE_ON_START=true
MEMEQUANT_RECONCILE_ON_RECONNECT=true
MEMEQUANT_MAX_RECONCILE_SIGNATURES=2000
MEMEQUANT_HTTP_CONCURRENCY=8
MEMEQUANT_PARQUET_BATCH_SIZE=500
MEMEQUANT_RAW_FSYNC_EVERY=100
MEMEQUANT_MAX_SUPPORTED_TRANSACTION_VERSION=0
MEMEQUANT_LOG_LEVEL=INFO
